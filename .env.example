NODE_ENV=development
PORT=3000

# Neon Postgres connection string. Use the DIRECT connection string (no
# "-pooler" in the hostname), not the pooled/PgBouncer one — this app
# already manages its own persistent connection pool (see database.ts and
# src/auth/auth.ts), and the pooled string is meant for serverless
# functions with many short-lived connections instead. Get this from the
# Neon Console → Connect → toggle "Connection pooling" OFF.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/boutica?sslmode=require

# Comma-separated list of allowed origins. Required (no permissive
# fallback) once NODE_ENV=production — enforced in src/config/env.schema.ts.
# v2.1: also used directly as Better Auth's `trustedOrigins` (src/auth/auth.ts)
# — one list of allowed origins for both CORS and Better Auth's own
# cookie/CSRF origin check, not two separate settings to keep in sync.
CORS_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Must be at least 32 characters. Never commit a real value. Signs Better
# Auth's sessions and the JWT plugin's tokens — see src/auth/auth.ts.
BETTER_AUTH_SECRET=replace-me-with-a-random-secret-at-least-32-characters-long

# The externally-reachable base URL of this API. Used by Better Auth to
# build callback links and as the issuer/audience for JWT/JWKS. Must match
# what clients actually hit.
BETTER_AUTH_URL=http://localhost:3000
